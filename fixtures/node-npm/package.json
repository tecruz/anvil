{
  "name": "acme-api",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:fast": "vitest run --changed",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^9.3.0",
    "prettier": "^3.2.5",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
