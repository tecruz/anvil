# build output
packages/*/dist/
*.tsbuildinfo

# dependencies
node_modules/

# anvil's own per-repo state (staging, ticket context bundles).
# Never commit: staging is regenerated and ticket context is company-internal.
.anvil/

# pinned external pilot repositories are local run inputs, not source
eval/repos/country-tracker/
eval/repos/nbim-position-increases/
eval/repos/books-pinned/

# local scratch
*.log
.DS_Store
Thumbs.db

# eval harness raw output
eval-results/raw/

# eval harness per-run checkpoints (regenerated each run)
eval-results/checkpoints/

# eval harness per-run real-agent summary (written by --check-run, never committed)
eval-results/benchmark-summary.json

# editor
.vscode/
.idea/
