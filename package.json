{
  "name": "anvil",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-ready dev harness: audit repos, derive agent context, work tickets in parallel worktrees.",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "cli",
    "code-review",
    "developer-tools",
    "git",
    "opencode",
    "worktree"
  ],
  "bin": {
    "anvil": "./packages/cli/dist/cli.js"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecruz/anvil.git"
  },
  "homepage": "https://github.com/tecruz/anvil#readme",
  "bugs": {
    "url": "https://github.com/tecruz/anvil/issues"
  },
  "files": [
    "packages/cli/dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run gen:playbooks && node scripts/build.mjs",
    "gen:playbooks": "node scripts/gen-playbooks.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --test --test-reporter=spec \"packages/*/test/*.test.ts\"",
    "test:live": "node --test --test-reporter=spec \"packages/providers/test/gh-live.test.ts\"",
    "test:changed": "node scripts/test-changed.mjs",
    "test:watch": "node --test --watch \"packages/*/test/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ci:local": "npm ci && npm run check",
    "clean": "node scripts/clean.mjs",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
